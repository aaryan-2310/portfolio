{
    "version": 2,
    "buildCommand": "yarn build",
    "outputDirectory": "dist/browser",
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "/api/sitemap"
        },
        {
            "source": "/((?!robots\\.txt|llms\\.txt|sitemap\\.xml|api/).*)",
            "destination": "/index.html"
        }
    ]
}
